# Copy to .env.local for local dev, and set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser, and those are safe to publish.

# Public site URL (used for canonical URLs, sitemap, Open Graph). Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (spam protection on the contact form).
# These are Cloudflare's official TEST keys (always pass). Replace with real keys from dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (only the content="" value). Optional if you verify by DNS.
NEXT_PUBLIC_GSC_VERIFICATION=

# Resend (sends each enquiry to your inbox). Without a key, enquiries are logged on the server only.
RESEND_API_KEY=
ENQUIRY_TO=orvynsols@gmail.com
ENQUIRY_FROM=Orvyn Website <onboarding@resend.dev>
